#N canvas 100 100 700 540 12;
#X obj 40 380 csound7~ 3_buffer_player.csd 32;
#X obj 40 460 dac~ 1 2;
#X text 20 20 Example 3: pick a mono WAV -> Pd array 'buf1' (via soundfiler) -> buf2tab -> Csound table -> tablei playback.;
#X obj 40 60 array define buf1 44100;
#X obj 400 40 bng 20 250 50 0 empty empty empty 0 -8 0 8 #fcfcfc #000000 #000000;
#X text 430 40 1 click to pick a mono WAV;
#X obj 400 80 openpanel;
#X msg 400 120 read -resize \$1 buf1;
#X obj 400 160 soundfiler;
#X msg 335 201 buf2tab buf1 1;
#X text 500 200 2 auto-sent once the file is loaded (loads it into Csound's table);
#X msg 400 240 buf_sr_1 44100;
#X text 500 240 3 IMPORTANT: edit 44100 to your file's real samplerate - Pd arrays don't carry this the way Max's buffer~ does (no auto-detect here);
#X msg 400 300 event i 1 0 -1;
#X text 500 300 4 play - after buf2tab AND buf_sr_1;
#X msg 400 340 event i -1 0 0;
#X text 500 340 5 stop;
#X msg 400 380 rate 1;
#X msg 480 380 amp 0.3;
#X text 500 380 optional\, while playing;
#X text 20 500 control messages go to the LEFTMOST inlet (opposite of the Max version - see MANUAL.md);
#X connect 0 0 1 0;
#X connect 0 1 1 1;
#X connect 4 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 0 0;
#X connect 11 0 0 0;
#X connect 13 0 0 0;
#X connect 15 0 0 0;
#X connect 17 0 0 0;
#X connect 18 0 0 0;
