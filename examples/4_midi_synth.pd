#N canvas 100 100 700 420 12;
#X obj 40 260 csound7~ 4_midi_synth.csd 32;
#X obj 40 330 dac~ 1 2;
#X text 20 20 Option A: connect a MIDI keyboard (Media > MIDI Settings in Pd/plugdata) and play.;
#X obj 40 60 notein;
#X text 160 64 pitch, velocity, channel (channel unused);
#X obj 40 100 pack 0 0;
#X obj 40 140 prepend 144;
#X text 140 144 144 = note-on status byte - velocity 0 means note-off;
#X obj 40 180 prepend midi;
#X text 320 20 Option B: no MIDI hardware? click these instead;
#X msg 320 60 midi 144 60 100;
#X text 440 64 note on (middle C);
#X msg 320 100 midi 144 60 0;
#X text 440 104 note off (velocity 0);
#X connect 0 0 1 0;
#X connect 0 1 1 1;
#X connect 3 0 5 0;
#X connect 3 1 5 1;
#X connect 5 0 6 0;
#X connect 6 0 8 0;
#X connect 8 0 0 0;
#X connect 10 0 0 0;
#X connect 12 0 0 0;
