#N canvas 100 100 700 440 12;
#X obj 40 340 csound7~ 5_diskin_player.csd 32;
#X obj 40 400 dac~ 1 2;
#X obj 40 40 bng 20 250 50 0 empty empty empty 0 -8 0 8 #fcfcfc #000000 #000000;
#X text 80 44 1 click to pick a WAV/AIFF/MP3 file;
#X obj 40 90 openpanel;
#X obj 40 140 prepend diskinfile wavpath;
#X text 220 144 sends diskinfile wavpath <path> to csound7~;
#X msg 40 190 event i 1 0 -1;
#X text 140 194 2 play - do this AFTER step 1;
#X msg 79 228 event i -1 0 0;
#X text 179 234 3 stop;
#X msg 40 280 wavamp 0.5;
#X text 140 284 optional\, while playing;
#X text 20 420 control messages go to the LEFTMOST inlet (opposite of the Max version - see MANUAL.md);
#X connect 0 0 1 0;
#X connect 0 1 1 1;
#X connect 2 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 0 0;
#X connect 7 0 0 0;
#X connect 9 0 0 0;
#X connect 11 0 0 0;
